# ═══════════════════════════════════════════════════════════════════════════════
#  UNION BANK  –  .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ── Environment & secrets (CRITICAL - NEVER COMMIT) ──────────────────────────
.env
.env.*
*.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production
!.env.example
!.env.*.example
!.env.template
!.env.sample
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example

# Private keys, certificates & credentials
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
*.der
*.id_rsa
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud & service credentials
credentials.json
*credentials*.json
client_secret*.json
client_secrets*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
google-services.json
google-credentials*.json
GoogleService-Info.plist
.aws/
.azure/
.gcp/
gcloud/
.act-secrets
*.secrets.*
.secrets
*.publishsettings
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
kubeconfig
*.kubeconfig
.kube/

# Password vaults & cryptographic stores
*.kdbx

# Authentication tokens & configs
.netrc
.pypirc
.npmrc
*token*.json
token.pickle
auth*.json

# ── Python byte-code & caches ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyc
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ── Python build artifacts ───────────────────────────────────────────────────
*.egg-info/
*.egg
.eggs/
dist/
build/

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
.env/
.venv*/
env.bak/
venv.bak/

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.vscode/*.local.*
.vscode/mcp.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── OS / Windows artifacts ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.bak
nul
*.tmp
*.temp

# ── Project data — JSON legacy storage ───────────────────────────────────────
data/*.json
!data/*.sample.json
data/*.bak

# ── Project data — Log files ─────────────────────────────────────────────────
data/*.jsonl
data/*.log
*.jsonl
*.log
logs/

# ── Project data — SQLite databases (ALL locations) ──────────────────────────
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-vacuum
src/data/*.db
src/data/*.db-wal
src/data/*.db-shm
src/**/data/*.db
src/**/data/*.db-wal
src/**/data/*.db-shm
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.dump
*.stackdump
*.sql.gz
*.rdb

# ── Temporary test database directories ──────────────────────────────────────
data/fresh_*/
data/seed_*/
data/test_*/
data/tmp_*/
data_test/

# ── Duplicate/legacy data directories ────────────────────────────────────────
src/data/

# ── Legacy empty stub directories ────────────────────────────────────────────
src/application/
src/domain/
src/infrastructure/
src/utils/

# ── Coverage reports ─────────────────────────────────────────────────────────
htmlcov/
.coverage
.coverage.*
coverage.xml
.coverage/

# ── Frontend (node_modules, builds, env) ─────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Misc generated files ─────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
radar_balance.txt
requirements-lock.txt

# =====================================================================
# KEEP: AI provenance & transparency files — these must remain
# visible to any repository viewer. Do not add rules above this block
# that would shadow a directory these files live in without also
# adding a negation here. Verified with `git check-ignore -v`.
# =====================================================================
!AI_DISCLOSURE.md
!AI_USAGE.md
!PROMPTS.md
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.cursorrules
!.github/copilot-instructions.md
!.claude/commands/
!.claude/commands/**
!.claude/agents/
!.claude/agents/**
!.claude/settings.json
!docs/ai/
!docs/ai/**
!.ai/
!.ai/**
!ai-provenance.json
!.gitmessage
!CITATION.cff
